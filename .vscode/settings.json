{
    "files.eol": "\n",
    "files.associations": {
        "*.tex": "latex"
    },
    "editor.formatOnSave": true,

    // Se compila con el .latexmkrc del repo para que VS Code, la CLI y la CI
    // produzcan el mismo PDF. Todos los documentos van al out/ de la raíz.
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/out",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-r",
                "%WORKSPACE_FOLDER%/.latexmkrc",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": ["latexmk"]
        }
    ],
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.synctex.afterBuild.enabled": true,

    "latex-workshop.linting.chktex.enabled": true,
    "latex-workshop.linting.chktex.exec.path": "chktex",

    "latex-workshop.latexindent.path": "latexindent",
    "latex-workshop.latexindent.args": [
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-y=defaultIndent: '%INDENT%'"
    ]
}
